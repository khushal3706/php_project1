{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/router.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/api/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/(.*)", "dest": "/api/router.php" }
  ]
}
